#!/usr/bin/env bash

set -e

echo "Installing PhotoGIMP..."

OS="$(uname)"
CONFIG_DIR="$HOME/.config/GIMP"
GIMP_VERSION_OUTPUT="$(gimp -v)"

if [[ "$GIMP_VERSION_OUTPUT" =~ ([0-9]+)\.([0-9]+) ]]; then
  GIMP_CONFIG_VERSION="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
else
  echo "Could not detect GIMP version from: $GIMP_VERSION_OUTPUT" >&2
  exit 1
fi

if [[ "$OS" == "Darwin" ]]; then
  CONFIG_DIR="$HOME/Library/Application Support/GIMP"
fi

mkdir -p "$CONFIG_DIR"

if [[ -d "$CONFIG_DIR/$GIMP_CONFIG_VERSION" ]]; then
  BACKUP="$CONFIG_DIR/$GIMP_CONFIG_VERSION.backup.$(date +%s)"
  mv "$CONFIG_DIR/$GIMP_CONFIG_VERSION" "$BACKUP"
  echo "Backup created at $BACKUP"
fi

TMP_DIR=$(mktemp -d)
cd "$TMP_DIR"
curl -L -o photogimp.zip https://github.com/Diolinux/PhotoGIMP/releases/latest/download/PhotoGIMP.zip
unzip -q photogimp.zip
cp -r 3.0 "$CONFIG_DIR/$GIMP_CONFIG_VERSION"
